# @anthropic-ai/claude-agent-sdk peer-requires zod ^4.0.0; yak's own
# artifact/schema code is on zod ^3.23.8. The SDK's zod v4 peer is for its
# own tool-definition helpers (createSdkMcpServer, tool()), which yak's
# adapter doesn't use — safe to bypass the peer conflict rather than bump
# yak's zod major version for it.
legacy-peer-deps=true
