# Only needed for the claude-code adapter (--adapter claude-code).
# The mock adapter needs no auth at all.
#
# Set exactly one of these:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: point the underlying `claude` CLI at a different
# Anthropic-Messages-API-compatible endpoint instead of api.anthropic.com
# (e.g. a local model server exposing an Anthropic-compatible route).
# ANTHROPIC_API_KEY above still needs *some* value even when the target
# doesn't check it — leave it non-empty (a placeholder is fine).
# ANTHROPIC_BASE_URL=http://127.0.0.1:8000

# Default model the CLI requests when a workflow's agent step doesn't
# set its own `model:` field. A step-level `model:` in the YAML always
# wins over this. Only meaningful alongside ANTHROPIC_BASE_URL above —
# set it to whatever your local server expects.
# ANTHROPIC_MODEL=qwen3-27b

# Copy to .env (gitignored) and fill in a real value, then:
#   npx tsx --env-file=.env src/cli/index.ts run <workflow.yaml> --adapter claude-code
