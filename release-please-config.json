{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "packages/kiln": {
      "release-type": "node",
      "component": "kiln",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/kiln'].version"
        }
      ]
    },
    "packages/yak": {
      "release-type": "node",
      "component": "yak",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/yak'].version"
        }
      ]
    }
  }
}
